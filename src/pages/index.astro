    }

    .button-dark:hover {

      transform: translateY(-3px);

      background: var(--blue);

    }

    .button-light {

      background: var(--white);

      color: var(--ink);

    }

    .button-light:hover {

      transform: translateY(-3px);

      background: var(--ink);

      color: var(--white);

    }

    .button-link,

    .inline-link {

      display: inline-flex;

      align-items: center;

      gap: 12px;

      font-weight: 800;

      transition:

        gap 0.25s ease,

        color 0.25s ease;

    }

    .button-link:hover,

    .inline-link:hover {

      gap: 18px;

      color: var(--blue);

    }

    /* HERO MEDIA */

    .hero-media {

      position: relative;

      animation:

        heroMediaIn

        1.1s

        cubic-bezier(0.16, 1, 0.3, 1)

        0.15s

        both;

    }

    .hero-image {

      position: relative;

      height:

        min(

          690px,

          72vh

        );

      overflow: hidden;

      background: var(--soft-blue);

      transform:

        perspective(1400px)

        rotateY(-2deg)

        rotateX(1deg)

        skewY(-1deg);

      transform-origin: center center;

      box-shadow:

        0 30px 80px

        rgba(

          7,

          26,

          51,

          0.16

        );

      transition:

        transform 0.8s

          cubic-bezier(0.16, 1, 0.3, 1),

        box-shadow 0.8s ease;

    }

    .hero-media:hover .hero-image {

      transform:

        perspective(1400px)

        rotateY(0deg)

        rotateX(0deg)

        skewY(0deg)

        scale(1.012);

      box-shadow:

        0 40px 100px

        rgba(

          7,

          26,

          51,

          0.22

        );

    }

    .hero-image::after {

      content: "";

      position: absolute;

      inset: 0;

      background:

        linear-gradient(

          180deg,

          rgba(7, 26, 51, 0) 35%,

          rgba(7, 26, 51, 0.48) 100%

        );

      pointer-events: none;

    }

    .hero-image img {

      width: 100%;

      height: 100%;

      display: block;

      object-fit: cover;

      transform: scale(1.04);

      transition:

        transform 1.4s

        cubic-bezier(0.16, 1, 0.3, 1);

    }

    .hero-media:hover

    .hero-image img {

      transform: scale(1.085);

    }

    .hero-carousel-image {

      opacity: 1;

      transition:

        opacity 0.45s ease,

        transform 1.4s

        cubic-bezier(0.16, 1, 0.3, 1);

    }

    .hero-carousel-image.hero-image-changing {

      opacity: 0.12;

      transform: scale(1.07);

    }

    .hero-tagline {

      position: absolute;

      left: -48px;

      bottom: 34px;

      z-index: 5;

      display: flex;

      flex-direction: column;

      align-items: flex-start;

      margin: 0;

      color: var(--white);

      font-size:

        clamp(

          1.1rem,

          2.15vw,

          2.3rem

        );

      line-height: 0.92;

      letter-spacing: -0.035em;

      transform:

        skewX(-6deg)

        rotate(-1.5deg);

      transform-origin: left bottom;

      filter:

        drop-shadow(

          0 12px 24px

          rgba(0, 0, 0, 0.22)

        );

      animation:

        taglineEnter

        1s

        cubic-bezier(0.16, 1, 0.3, 1)

        0.45s

        both;

    }

    .hero-tagline span,

    .hero-tagline strong {

      display: inline-block;

      font-style: normal;

    }

    .hero-tagline span:first-child {

      padding: 7px 13px 8px;

      background: var(--ink);

      color: var(--white);

      font-size: 0.48em;

      font-weight: 800;

      letter-spacing: 0.16em;

    }

    .hero-tagline strong {

      margin-top: 3px;

      padding: 10px 18px 12px;

      background: var(--blue);

      color: var(--white);

      font-size: 1em;

      font-weight: 900;

      letter-spacing: -0.055em;

      box-shadow:

        10px

        10px

        0

        rgba(

          7,

          26,

          51,

          0.88

        );

    }

    .hero-tagline span:last-child {

      margin-top: 7px;

      padding: 8px 14px 9px;

      background: var(--white);

      color: var(--ink);

      border-left:

        5px solid

        var(--blue);

      font-size: 0.52em;

      font-weight: 900;

      letter-spacing: 0.02em;

      box-shadow:

        7px

        7px

        0

        rgba(

          7,

          26,

          51,

          0.13

        );

    }

    .hero-tagline::after {

      content: "";

      position: absolute;

      left: -26px;

      bottom: -13px;

      width: 125%;

      height: 2px;

      background: var(--blue);

      transform:

        scaleX(0)

        skewX(-12deg);

      transform-origin: left;

      animation:

        taglineLine

        0.9s

        cubic-bezier(0.16, 1, 0.3, 1)

        1.15s

        forwards;

    }

    .hero-image-progress {

      position: absolute;

      left: 22px;

      right: 22px;

      bottom: 18px;

      z-index: 4;

      display: flex;

      gap: 7px;

    }

    .hero-image-progress span {

      width: 32px;

      height: 2px;

      background:

        rgba(

          255,

          255,

          255,

          0.45

        );

      transition:

        width 0.35s ease,

        background 0.35s ease;

    }

    .hero-image-progress

    .hero-progress-active {

      width: 58px;

      background: var(--white);

    }

    /* INTRO */

    .intro {

      background: var(--white);

    }

    .intro-grid {

      display: grid;

      grid-template-columns:

        minmax(0, 0.85fr)

        minmax(0, 1.15fr);

      gap: 80px;

      align-items: start;

    }

    .intro-title h2 {

      margin: 0;

      max-width: 590px;

      font-size:

        clamp(

          2.3rem,

          4vw,

          4.4rem

        );

      line-height: 0.98;

      letter-spacing: -0.055em;

    }

    .intro-content {

      max-width: 650px;

    }

    .intro-content p {

      margin:

        0

        0

        20px;

      color: #4d5d72;

      font-size: 1.05rem;

      line-height: 1.75;

    }

    /* SERVICES */

    .section-heading {

      display: flex;

      align-items: flex-end;

      justify-content: space-between;

      gap: 60px;

      margin-bottom: 42px;

    }

    .section-heading h2,

    .projects-heading h2,

    .insights-heading h2 {

      margin: 0;

      font-size:

        clamp(

          2.4rem,

          4vw,

          4.2rem

        );

      line-height: 0.98;

      letter-spacing: -0.055em;

    }

    .section-heading p {

      max-width: 510px;

      margin: 0;

      color: var(--muted);

      line-height: 1.7;

    }

    .service-grid {

      display: grid;

      grid-template-columns:

        1fr

        1fr;

      gap: 2px;

      background: var(--ink);

    }

    .service-card {

      position: relative;

      display: flex;

      min-height: 460px;

      overflow: hidden;

      background: var(--white);

      transition:

        transform 0.45s

          cubic-bezier(0.16, 1, 0.3, 1),

        background 0.45s ease;

    }

    .service-card:hover {

      transform: translateY(-8px);

      background: #fafdff;

    }

    .service-card-wide {

      grid-column: 1 / -1;

      min-height: 360px;

    }

    .service-content {

      position: relative;

      z-index: 2;

      display: flex;

      flex-direction: column;

      justify-content: space-between;

      width: 100%;

      min-height: 100%;

      padding: 42px;

    }

    .service-content h3 {

      max-width: 650px;

      margin: 0;

      font-size:

        clamp(

          1.8rem,

          2.6vw,

          3rem

        );

      line-height: 1.03;

      letter-spacing: -0.045em;

    }

    .service-content p {

      max-width: 670px;

      margin:

        28px

        0

        auto;

      color: var(--muted);

      line-height: 1.7;

    }

    .service-list {

      display: flex;

      flex-wrap: wrap;

      gap: 8px;

      margin-top: 28px;

    }

    .service-list span {

      padding:

        8px

        12px;

      border:

        1px solid

        var(--line);

      font-size: 0.76rem;

      font-weight: 800;

      letter-spacing: 0.02em;

    }

    .service-action {

      display: flex;

      align-items: center;

      justify-content: space-between;

      max-width: 240px;

      margin-top: 30px;

      color: var(--blue);

      font-weight: 900;

    }

    /* EXPERIENCE */

    .experience-grid {

      display: grid;

      grid-template-columns:

        minmax(0, 1fr)

        minmax(0, 1fr);

      gap: 80px;

      align-items: center;

    }

    .experience-image {

      min-height: 620px;

      overflow: hidden;

      background: var(--soft-blue);

    }

    .experience-image img {

      width: 100%;

      height: 100%;

      min-height: 620px;

      display: block;

      object-fit: cover;

    }

    .experience-content {

      max-width: 640px;

    }

    .experience-content h2 {

      margin:

        0

        0

        30px;

      font-size:

        clamp(

          2.4rem,

          4vw,

          4.4rem

        );

      line-height: 0.98;

      letter-spacing: -0.055em;

    }

    .experience-content p {

      margin:

        0

        0

        20px;

      color: var(--muted);

      line-height: 1.75;

    }

    /* NUMBERS */

    .numbers-grid {

      display: grid;

      grid-template-columns:

        repeat(

          4,

          1fr

        );

      margin-top: 70px;

      border-top:

        1px solid

        var(--line);

      border-bottom:

        1px solid

        var(--line);

    }

    .number-item {

      min-height: 190px;

      display: flex;

      flex-direction: column;

      justify-content: center;

      padding: 28px;

      border-right:

        1px solid

        var(--line);

    }

    .number-item:last-child {

      border-right: 0;

    }

    .number-item strong {

      display: block;

      color: var(--blue);

      font-size:

        clamp(

          3rem,

          5vw,

          5rem

        );

      line-height: 0.9;

      letter-spacing: -0.07em;

      font-weight: 900;

    }

    .number-item span {

      max-width: 180px;

      margin-top: 18px;

      color: var(--muted);

      font-size: 0.85rem;

      line-height: 1.45;

      font-weight: 700;

    }

    /* PROCESS */

    .process-intro {

      display: grid;

      grid-template-columns:

        1fr

        1fr;

      gap: 70px;

      margin-bottom: 55px;

    }

    .process-intro h2 {

      margin: 0;

      max-width: 650px;

      font-size:

        clamp(

          2.5rem,

          4vw,

          4.7rem

        );

      line-height: 0.98;

      letter-spacing: -0.06em;

    }

    .process-intro p {

      margin: 0;

      color:

        rgba(

          255,

          255,

          255,

          0.68

        );

      line-height: 1.75;

    }

    .process-row {

      display: grid;

      grid-template-columns:

        110px

        1fr;

      gap: 40px;

      padding: 32px 0;

      border-top:

        1px solid

        rgba(

          255,

          255,

          255,

          0.13

        );

    }

    .process-row:last-child {

      border-bottom:

        1px solid

        rgba(

          255,

          255,

          255,

          0.13

        );

    }

    .process-number {

      color: var(--blue);

      font-size: 0.8rem;

      font-weight: 900;

      letter-spacing: 0.08em;

    }

    .process-main h3 {

      margin:

        0

        0

        12px;

      font-size:

        clamp(

          1.5rem,

          2.4vw,

          2.5rem

        );

      letter-spacing: -0.035em;

    }

    .process-main p {

      max-width: 760px;

      margin: 0;

      color:

        rgba(

          255,

          255,

          255,

          0.64

        );

      line-height: 1.7;

    }

    /* TURNKEY */

    .turnkey-grid {

      display: grid;

      grid-template-columns:

        minmax(0, 0.9fr)

        minmax(0, 1.1fr);

      gap: 80px;

      align-items: center;

    }

    .turnkey-content {

      max-width: 620px;

    }

    .turnkey-content h2 {

      margin:

        0

        0

        28px;

      font-size:

        clamp(

          2.5rem,

          4vw,

          4.5rem

        );

      line-height: 0.98;

      letter-spacing: -0.06em;

    }

    .turnkey-content p {

      margin:

        0

        0

        20px;

      color: var(--muted);

      line-height: 1.75;

    }

    .turnkey-visual {

      display: flex;

      align-items: center;

      justify-content: center;

      min-height: 420px;

      padding: 35px;

      background: #f4f8fb;

      overflow: hidden;

    }

    .turnkey-visual img {

      width: 100%;

      height: auto;

      display: block;

    }

    /* INTEGRATED */

    .integrated-heading {

      display: grid;

      grid-template-columns:

        1fr

        0.8fr;

      gap: 70px;

      margin-bottom: 50px;

    }

    .integrated-heading h2 {

      margin: 0;

      font-size:

        clamp(

          2.5rem,

          4vw,

          4.6rem

        );

      line-height: 0.98;

      letter-spacing: -0.06em;

    }

    .integrated-heading p {

      margin: 0;

      color: var(--muted);

      line-height: 1.75;

    }

    .integrated-grid {

      display: grid;

      grid-template-columns:

        1fr

        1fr;

      gap: 2px;

      background: var(--ink);

    }

    .integrated-card {

      padding: 42px;

      background: var(--white);

    }

    .integrated-card h3 {

      margin:

        0

        0

        18px;

      font-size: 1.8rem;

      letter-spacing: -0.04em;

    }

    .integrated-card p {

      margin: 0;

      color: var(--muted);

      line-height: 1.7;

    }

    .integrated-result {

      grid-column: 1 / -1;

      display: grid;

      grid-template-columns:

        0.8fr

        1.2fr;

      gap: 40px;

      padding:

        38px

        42px;

      background: var(--blue);

      color: var(--white);

    }

    .integrated-result strong {

      font-size:

        clamp(

          1.7rem,

          3vw,

          3rem

        );

      line-height: 1;

      letter-spacing: -0.04em;

    }

    .integrated-result p {

      margin: 0;

      color:

        rgba(

          255,

          255,

          255,

          0.8

        );

      line-height: 1.65;

    }

    /* PROJECTS */

    .projects-heading,

    .insights-heading {

      display: flex;

      align-items: flex-end;

      justify-content: space-between;

      gap: 50px;

      margin-bottom: 42px;

    }

    .projects-heading p,

    .insights-heading p {

      max-width: 620px;

      margin:

        20px

        0

        0;

      color: var(--muted);

      line-height: 1.7;

    }

    .project-feature {

      display: grid;

      grid-template-columns:

        1.1fr

        0.9fr;

      min-height: 540px;

      background: var(--ink);

      color: var(--white);

      overflow: hidden;

    }

    .project-feature-image {

      min-height: 540px;

      overflow: hidden;

      transform:

        translate3d(

          var(--pointer-x, 0px),

          var(--pointer-y, 0px),

          0

        );

      transition:

        transform 0.25s ease;

    }

    .project-feature-image img {

      width: 100%;

      height: 100%;

      display: block;

      object-fit: cover;

      transition:

        transform 0.8s

        cubic-bezier(0.16, 1, 0.3, 1);

    }

    .project-feature:hover

    .project-feature-image img {

      transform: scale(1.06);

    }

    .project-feature-content {

      display: flex;

      flex-direction: column;

      justify-content: center;

      padding: 60px;

    }

    .project-feature-content h3 {

      margin:

        0

        0

        24px;

      font-size:

        clamp(

          2rem,

          3.2vw,

          3.5rem

        );

      line-height: 1;

      letter-spacing: -0.05em;

    }

    .project-feature-content p {

      margin: 0;

      color:

        rgba(

          255,

          255,

          255,

          0.65

        );

      line-height: 1.75;

    }

    .project-feature-content strong {

      margin-top: 34px;

      color: var(--white);

      font-size: 0.9rem;

    }

    /* INSIGHTS */

    .insight-grid {

      display: grid;

      grid-template-columns:

        repeat(

          3,

          1fr

        );

      gap: 2px;

      background: var(--ink);

    }

    .insight-card {

      min-height: 310px;

      display: flex;

      flex-direction: column;

      justify-content: space-between;

      padding: 36px;

      background: var(--white);

      transition:

        transform 0.4s

        cubic-bezier(0.16, 1, 0.3, 1);

    }

    .insight-card:hover {

      transform: translateY(-7px);

    }

    .insight-card h3 {

      margin: 0;

      font-size: 1.55rem;

      line-height: 1.1;

      letter-spacing: -0.035em;

    }

    .insight-card p {

      margin:

        25px

        0;

      color: var(--muted);

      line-height: 1.65;

    }

    .insight-card strong {

      color: var(--blue);

      font-size: 0.85rem;

    }

    /* FINAL CTA */

    .final-cta {

      padding: 85px 0;

      background: var(--blue);

      color: var(--white);

    }

    .final-cta-inner {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 60px;

    }

    .final-cta h2 {

      max-width: 850px;

      margin: 0;

      font-size:

        clamp(

          2.5rem,

          5vw,

          5.5rem

        );

      line-height: 0.92;

      letter-spacing: -0.065em;

    }

    .final-cta h2 span {

      display: block;

    }

    .final-cta p {

      max-width: 720px;

      margin:

        24px

        0

        0;

      color:

        rgba(

          255,

          255,

          255,

          0.78

        );

      line-height: 1.7;

    }

    /* MOTION */

    .motion-enabled

    .motion-reveal {

      opacity: 0;

      transform:

        translateY(35px);

      transition:

        opacity 0.85s

          cubic-bezier(0.16, 1, 0.3, 1),

        transform 0.85s

          cubic-bezier(0.16, 1, 0.3, 1);

      transition-delay:

        var(

          --motion-delay,

          0ms

        );

    }

    .motion-enabled

    .motion-reveal.motion-visible {

      opacity: 1;

      transform:

        translateY(0);

    }

    @keyframes heroMediaIn {

      from {

        opacity: 0;

        transform:

          translateX(45px)

          scale(0.96);

      }

      to {

        opacity: 1;

        transform:

          translateX(0)

          scale(1);

      }

    }

    @keyframes taglineEnter {

      from {

        opacity: 0;

        transform:

          translate(

            -45px,

            30px

          )

          skewX(-12deg)

          rotate(-5deg)

          scale(0.9);

      }

      to {

        opacity: 1;

        transform:

          translate(

            0,

            0

          )

          skewX(-6deg)

          rotate(-1.5deg)

          scale(1);

      }

    }

    @keyframes taglineLine {

      from {

        transform:

          scaleX(0)

          skewX(-12deg);

      }

      to {

        transform:

          scaleX(1)

          skewX(-12deg);

      }

    }

    /* TABLET */

    @media (max-width: 1050px) {

      .hero-container {

        grid-template-columns: 1fr;

      }

      .hero-media {

        max-width: 720px;

        width: 100%;

        margin-left: auto;

      }

      .service-grid {

        grid-template-columns:

          1fr

          1fr;

      }

      .service-card-wide {

        grid-column:

          1 / -1;

      }

      .numbers-grid {

        grid-template-columns:

          1fr

          1fr;

      }

      .number-item:nth-child(2) {

        border-right: 0;

      }

      .number-item:nth-child(-n + 2) {

        border-bottom:

          1px solid

          var(--line);

      }

      .integrated-heading {

        grid-template-columns: 1fr;

        gap: 25px;

      }

      .integrated-result {

        grid-template-columns:

          1fr

          1fr;

      }

    }

    /* MOBILE */

    @media (max-width: 800px) {

      .container {

        width:

          min(

            calc(100% - 44px),

            640px

          );

      }

      .section-space {

        padding: 64px 0;

      }

      .intro-grid,

      .experience-grid,

      .turnkey-grid,

      .process-intro {

        grid-template-columns: 1fr;

        gap: 22px;

      }

      .service-grid,

      .insight-grid,

      .project-feature {

        grid-template-columns: 1fr;

      }

      .service-card-wide {

        grid-column: auto;

      }

      .service-card {

        min-height: auto;

      }

      .service-content {

        min-height: 370px;

      }

      .experience-image,

      .experience-image img {

        min-height: 420px;

      }

      .project-feature-image {

        min-height: 270px;

      }

      .section-heading,

      .projects-heading,

      .insights-heading,

      .final-cta-inner {

        align-items: flex-start;

        flex-direction: column;

      }

      .section-heading,

      .projects-heading,

      .insights-heading {

        margin-bottom: 30px;

      }

      .integrated-grid {

        grid-template-columns: 1fr;

      }

      .integrated-result {

        grid-column: auto;

        grid-template-columns: 1fr;

      }

      .integrated-result p {

