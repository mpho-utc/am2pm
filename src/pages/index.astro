  <!-- SCRIPTS -->

  <script>
    import AOS from "aos";
    import "aos/dist/aos.css";

    type HeroImage = { src: string; alt: string };

    const heroImages: HeroImage[] = [
      {
        src: "https://images.pexels.com/photos/3862375/pexels-photo-3862375.jpeg?auto=compress&cs=tinysrgb&w=1800",
        alt: "Engineering professionals working in an industrial environment",
      },
      {
        src: "https://images.pexels.com/photos/3862130/pexels-photo-3862130.jpeg?auto=compress&cs=tinysrgb&w=1800",
        alt: "Engineering professional working on technical equipment",
      },
      {
        src: "https://images.pexels.com/photos/386236/pexels-photo-386236.jpeg?auto=compress&cs=tinysrgb&w=1800",
        alt: "Industrial engineering project environment",
      },
      {
        src: "https://images.pexels.com/photos/373543/pexels-photo-373543.jpeg?auto=compress&cs=tinysrgb&w=1800",
        alt: "Industrial facility and technical operations",
      },
    ];

    const heroImage = document.querySelector<HTMLImageElement>(".hero-carousel-image");
    const progressItems = document.querySelectorAll<HTMLElement>(".hero-image-progress span");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let heroImageIndex = 0;

    if (heroImage && !reduceMotion) {
      heroImages.slice(1).forEach((item) => {
        const preload = new Image();
        preload.src = item.src;
      });

      window.setInterval(() => {
        heroImage.classList.add("hero-image-changing");
        window.setTimeout(() => {
          heroImageIndex = (heroImageIndex + 1) % heroImages.length;
          const next = heroImages[heroImageIndex];
          heroImage.src = next.src;
          heroImage.alt = next.alt;
          progressItems.forEach((item, index) => {
            item.classList.toggle("hero-progress-active", index === heroImageIndex);
          });
          heroImage.classList.remove("hero-image-changing");
        }, 250);
      }, 6500);
    }

    // Keep the existing experience figures, with a subtle count-up on entry.
    const numberItems = document.querySelectorAll<HTMLElement>("[data-count]");
    const setNumber = (element: HTMLElement) => {
      const target = Number(element.dataset.count || 0);
      const suffix = element.dataset.suffix || "";
      const start = performance.now();
      const duration = 900;
      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        element.textContent = `${Math.floor(target * eased)}${suffix}`;
        if (progress < 1) window.requestAnimationFrame(tick);
        else element.textContent = `${target}${suffix}`;
      };
      window.requestAnimationFrame(tick);
    };

    if (reduceMotion || !("IntersectionObserver" in window)) {
      numberItems.forEach((element) => {
        element.textContent = `${element.dataset.count || "0"}${element.dataset.suffix || ""}`;
      });
    } else {
      const numberObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          if (entry.target instanceof HTMLElement) setNumber(entry.target);
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.5 });
      numberItems.forEach((element) => numberObserver.observe(element));
    }

    AOS.init({
      duration: 650,
      easing: "ease-out-cubic",
      once: true,
      offset: 70,
      disable: reduceMotion,
    });
  </script>

  <style>
