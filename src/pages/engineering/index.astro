  /* =========================================================
     AM2PM HOMEPAGE VISUAL SYSTEM
     Applied consistently to the Engineering page.
     ========================================================= */

  .engineering-page {
    --ink: #303238;
    --ink-soft: #404248;
    --muted: #69717d;
    --blue: #4091bf;
    --blue-dark: #2e789f;
    --blue-light: #eaf4f9;
    --paper-soft: #f4f5f6;
    --line: #dfe2e6;
    color: var(--muted);
    background: #fff;
    font-family: "Open Sans", Arial, sans-serif;
    font-size: 15px;
    line-height: 1.85;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .engineering-page *,
  .engineering-page *::before,
  .engineering-page *::after {
    box-sizing: border-box;
  }

  .engineering-page h1,
  .engineering-page h2,
  .engineering-page h3,
  .engineering-page h4 {
    color: var(--ink-soft);
    font-family: "Open Sans", Arial, sans-serif;
    font-weight: 800;
    letter-spacing: .015em;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .engineering-page h2 {
    font-size: clamp(1.9rem, 3.4vw, 3.35rem);
    line-height: 1.04;
  }

  .engineering-page h2 span,
  .engineering-page h3 span {
    display: block;
    margin-top: .45rem;
    color: var(--blue);
  }

  .engineering-page p {
    line-height: 1.8;
  }

  .engineering-page .container {
    width: min(1200px, calc(100% - 64px));
    margin-inline: auto;
  }

  /* Rounded homepage buttons and text links */
  .engineering-page .button,
  .engineering-page a.button,
  .engineering-page .final-cta .button-dark {
    min-height: 48px;
    padding: 0 25px;
    border: 0;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    font-family: inherit;
    font-size: .82rem;
    font-weight: 800;
    letter-spacing: .015em;
    box-shadow: 0 7px 20px rgba(25, 65, 88, .12);
    transition:
      transform .25s ease,
      background .25s ease,
      color .25s ease,
      box-shadow .25s ease;
  }

  .engineering-page .button:hover,
  .engineering-page a.button:hover,
  .engineering-page .final-cta .button-dark:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 26px rgba(25, 65, 88, .18);
  }

  .engineering-page .hero .button-light,
  .engineering-page .final-cta .button-dark {
    background: #fff;
    color: var(--ink);
  }

  .engineering-page .hero .button-light:hover,
  .engineering-page .final-cta .button-dark:hover {
    background: var(--blue-light);
    color: var(--ink);
  }

  .engineering-page .button-dark {
    background: var(--ink);
    color: #fff;
  }

  .engineering-page .button-dark:hover {
    background: var(--blue);
    color: #fff;
  }

  .engineering-page .hero-link,
  .engineering-page .text-link,
  .engineering-page .inline-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: .84rem;
    font-weight: 800;
    transition: gap .25s ease, color .25s ease;
  }

  .engineering-page .hero-link:hover,
  .engineering-page .text-link:hover,
  .engineering-page .inline-link:hover {
    gap: 16px;
    color: var(--blue);
  }

