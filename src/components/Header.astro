---

const engineeringNavigation = [
  { label: 'Engineering & maintenance', href: '/engineering/#engineering-maintenance', icon: 'settings' },
  { label: 'Project delivery', href: '/engineering/#project-delivery', icon: 'layers' },
  { label: 'Automation & process optimisation', href: '/engineering/#automation', icon: 'automation' },
  { label: 'Electrical & energy solutions', href: '/engineering/#electrical-energy', icon: 'energy' },
  { label: 'Operational performance & asset care', href: '/engineering/#operational-performance', icon: 'performance' },
  { label: 'SHEQ', href: '/engineering/#sheq', icon: 'shield' },
];







const transformationNavigation = [

  { label: 'B-BBEE assessment & strategy', href: '/transformation/#assessment-strategy', icon: 'ownership' },

  { label: 'Employment equity & management control', href: '/transformation/#employment-equity', icon: 'management' },

  { label: 'Skills development', href: '/transformation/#skills-development', icon: 'skills' },

  { label: 'Enterprise & supplier development', href: '/transformation/#enterprise-development', icon: 'enterprise' },

  { label: 'Socio-economic development', href: '/transformation/#socio-economic-development', icon: 'socio' },

  { label: 'Verification readiness', href: '/transformation/#verification-readiness', icon: 'verification' },

  { label: 'Governance & reporting', href: '/transformation/#governance-reporting', icon: 'governance' },

  { label: 'Change management', href: '/transformation/#change-management', icon: 'change' },

];







const currentPath = Astro.url.pathname;



const engineeringActive = currentPath.startsWith('/engineering/');



const transformationActive = currentPath.startsWith('/transformation/');





---



<header class="site-header">



  <div class="header-container">



    <a href="/" class="brand" aria-label="AM2PM Consulting home">



      <img class="logo-img" src="/am2pm-logo.png" alt="AM2PM Consulting" />



    </a>







    <nav class="desktop-nav" aria-label="Main navigation">



      <a href="/" class:list={{ active: currentPath === '/' }}>Home</a>







      <div class:list={{ 'nav-dropdown': true, active: engineeringActive }}>



        <button class="nav-dropdown-trigger" type="button" aria-expanded="false" aria-haspopup="true">



          Engineering <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>



        </button>



        <div class="mega-menu" aria-label="Engineering menu">



          <div class="mega-menu-inner">



            <section class="mega-links engineering-links" aria-label="Engineering services">



              {engineeringNavigation.map((item) => (



                <a class="mega-link" href={item.href} class:list={{ selected: currentPath.startsWith('/engineering/') && Astro.url.hash === `#${item.href.split('#')[1]}` }}>



                  <span class="service-icon" aria-hidden="true">



                    {item.icon === 'settings' && <svg viewBox="0 0 32 32"><path d="M13 3h6l1 4 3 1 3-2 4 5-2 3 1 3 3 2-2 6-4-.2-2 2-.2 4h-6l-1-4-3-1-3 2-4-5 2-3-1-3-3-2 2-6 4 .2 2-2z"/><circle cx="16" cy="16" r="4"/></svg>}



                    {item.icon === 'layers' && <svg viewBox="0 0 32 32"><path d="m16 4 13 7-13 7L3 11zM3 16l13 7 13-7M3 21l13 7 13-7" /></svg>}



                    {item.icon === 'shield' && <svg viewBox="0 0 32 32"><path d="M16 3 27 7v8c0 7-4.5 11.5-11 14-6.5-2.5-11-7-11-14V7z"/><path d="m10 16 4 4 8-9"/></svg>}
                    {item.icon === 'automation' && <svg viewBox="0 0 32 32"><rect x="4" y="5" width="10" height="10" rx="2"/><rect x="18" y="17" width="10" height="10" rx="2"/><path d="M14 10h5v7M9 15v7h9"/></svg>}
                    {item.icon === 'energy' && <svg viewBox="0 0 32 32"><path d="m18 3-12 16h9l-1 10 12-17h-9z"/></svg>}
                    {item.icon === 'performance' && <svg viewBox="0 0 32 32"><path d="M4 26V6m0 20h24M9 21l6-7 5 3 7-9"/><path d="M22 8h5v5"/></svg>}



                  </span>



                  <span class="mega-link-copy"><strong>{item.label}</strong><small>Learn more about this service</small></span>



                  <svg class="link-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>



                </a>



              ))}



            </section>



          </div>



        </div>



      </div>







      <div class:list={{ 'nav-dropdown': true, active: transformationActive }}>



        <button class="nav-dropdown-trigger" type="button" aria-expanded="false" aria-haspopup="true">



          Transformation <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>



        </button>



        <div class="mega-menu" aria-label="Transformation menu">



          <div class="mega-menu-inner">



            <section class="mega-links transformation-links" aria-label="Transformation services">



              {transformationNavigation.map((item) => (



                <a class="mega-link" href={item.href}>



                  <span class="service-icon" aria-hidden="true">



                    {item.icon === 'ownership' && <svg viewBox="0 0 32 32"><circle cx="16" cy="10" r="5"/><path d="M6 28v-3a10 10 0 0 1 20 0v3M16 18v5m-4-2 4 4 4-4"/></svg>}



                    {item.icon === 'management' && <svg viewBox="0 0 32 32"><circle cx="16" cy="9" r="5"/><path d="M5 28v-3a11 11 0 0 1 22 0v3M3 15h6m14 0h6M16 2V1"/></svg>}



                    {item.icon === 'skills' && <svg viewBox="0 0 32 32"><path d="m3 11 13-7 13 7-13 7zM8 14v8c5 4 11 4 16 0v-8M29 11v10"/></svg>}



                    {item.icon === 'enterprise' && <svg viewBox="0 0 32 32"><path d="M4 28V9l12-5 12 5v19M2 28h28M10 13h3m6 0h3M10 19h3m6 0h3M14 28v-5h4v5"/></svg>}



                    {item.icon === 'socio' && <svg viewBox="0 0 32 32"><circle cx="11" cy="10" r="4"/><circle cx="23" cy="12" r="3"/><path d="M3 27v-3a8 8 0 0 1 16 0v3M20 21a6 6 0 0 1 9 5v1"/><path d="M16 4V1m-2 2h4"/></svg>}

                    {item.icon === 'verification' && <svg viewBox="0 0 32 32"><path d="M8 3h11l6 6v20H8zM19 3v7h6M12 17l3 3 6-7"/></svg>}

                    {item.icon === 'governance' && <svg viewBox="0 0 32 32"><rect x="4" y="5" width="24" height="22" rx="2"/><path d="M10 12h12M10 17h12M10 22h7"/></svg>}

                    {item.icon === 'change' && <svg viewBox="0 0 32 32"><path d="M6 10h18l-4-4M26 22H8l4 4M24 10l3 4-3 4M8 22l-3-4 3-4"/></svg>}



                  </span>



                  <span class="mega-link-copy"><strong>{item.label}</strong><small>Learn more about this service</small></span>



                  <svg class="link-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>



                </a>



              ))}



            </section>



          </div>



        </div>



      </div>







      <a href="/about/" class:list={{ active: currentPath.startsWith('/about/') }}>About</a>



      <a href="/projects/" class:list={{ active: currentPath.startsWith('/projects/') }}>Projects</a>



      <a href="/insights/" class:list={{ active: currentPath.startsWith('/insights/') }}>Insights</a>



      <a href="/contact/" class="nav-cta">Let's Talk <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8 3l5 5-5 5" /></svg></a>



    </nav>







    <button class="mobile-menu-button" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-navigation"><span></span><span></span><span></span></button>



  </div>







  <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation" aria-hidden="true">



    <a href="/" class:list={{ active: currentPath === '/' }}>Home</a>



    <details class="mobile-services-dropdown">



      <summary>Engineering <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>



      <div class="mobile-services">



        <p>Technical expertise, dependable maintenance and project delivery.</p>



        {engineeringNavigation.map((item) => <a href={item.href}>{item.label}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg></a>)}



        <a class="mobile-all-services" href="/engineering/">Explore engineering</a>



      </div>



    </details>



    <details class="mobile-services-dropdown">



      <summary>Transformation <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>



      <div class="mobile-services mobile-transformation-services">



        {transformationNavigation.map((item) => <a href={item.href}>{item.label}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg></a>)}



      </div>



    </details>



    <a href="/about/" class:list={{ active: currentPath.startsWith('/about/') }}>About</a>



    <a href="/projects/" class:list={{ active: currentPath.startsWith('/projects/') }}>Projects</a>



    <a href="/insights/" class:list={{ active: currentPath.startsWith('/insights/') }}>Insights</a>



    <a href="/contact/" class="mobile-nav-cta">Let's Talk</a>



  </nav>



</header>







<style>



  .site-header{position:fixed;inset:0 0 auto;z-index:1000;background:#fff;border-bottom:1px solid #e6ebef;box-shadow:0 8px 28px rgba(25,43,58,.045);font-family:'Open Sans',sans-serif}



  .header-container{width:min(100% - 64px,1400px);height:88px;margin:auto;display:flex;align-items:center;justify-content:space-between}



  .brand{display:flex;align-items:center;flex-shrink:0;text-decoration:none}.logo-img{display:block;height:64px;width:auto;object-fit:contain}



  .desktop-nav{height:100%;display:flex;align-items:center;gap:clamp(18px,2vw,32px)}



  .desktop-nav>a:not(.nav-cta),.nav-dropdown-trigger{position:relative;display:inline-flex;align-items:center;gap:8px;padding:0;border:0;background:none;color:#303238;font:600 13px 'Open Sans',sans-serif;text-decoration:none;white-space:nowrap;cursor:pointer;transition:color .2s ease}



  .desktop-nav>a:not(.nav-cta)::after,.nav-dropdown-trigger::after{content:'';position:absolute;left:0;right:0;bottom:-12px;height:2px;background:#4091bf;transform:scaleX(0);transform-origin:left;transition:transform .2s ease}



  .desktop-nav>a:hover,.desktop-nav>a.active,.nav-dropdown-trigger:hover,.nav-dropdown.active .nav-dropdown-trigger{color:#277eae}



  .desktop-nav>a:hover::after,.desktop-nav>a.active::after,.nav-dropdown.active .nav-dropdown-trigger::after{transform:scaleX(1)}



  .chevron{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s ease}



  .nav-dropdown{height:100%;display:flex;align-items:center}.nav-dropdown.is-open .chevron,.nav-dropdown:hover .chevron,.nav-dropdown:focus-within .chevron{transform:rotate(180deg)}



  .mega-menu{position:absolute;top:88px;left:0;width:100%;padding:34px 32px 40px;background:#fff;border-top:1px solid #edf0f2;box-shadow:0 24px 55px rgba(25,43,58,.13);opacity:0;visibility:hidden;pointer-events:none;transform:translateY(10px);transition:opacity .22s ease,transform .22s ease,visibility .22s ease}



  .nav-dropdown:hover .mega-menu,.nav-dropdown:focus-within .mega-menu,.nav-dropdown.is-open .mega-menu{opacity:1;visibility:visible;pointer-events:auto;transform:translateY(0)}



  .mega-menu-inner{width:min(1180px,100%);margin:auto;display:block}



  .mega-intro{padding:8px 0 8px 4px}.menu-eyebrow{color:#4091bf;font-size:10px;font-weight:800;letter-spacing:.19em}.mega-intro h2{margin:16px 0 13px;color:#303238;font-size:clamp(30px,3vw,43px);font-weight:700;letter-spacing:-.055em;line-height:1.04}.mega-intro h2 em{color:#4091bf;font-style:normal}.mega-intro p{max-width:370px;margin:0;color:#707984;font-size:13px;line-height:1.8}.menu-overview{display:inline-flex;align-items:center;gap:12px;margin-top:25px;color:#303238;font-size:12px;font-weight:750;text-decoration:none}.menu-overview svg,.nav-cta svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s ease}.menu-overview:hover{color:#277eae}.menu-overview:hover svg{transform:translateX(4px)}



  .mega-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px 18px}.transformation-links{grid-template-columns:repeat(4,minmax(0,1fr));gap:8px 12px}.mega-link{min-height:100px;display:flex;align-items:center;gap:17px;padding:20px 18px;color:#303238;text-decoration:none;border-bottom:1px solid #e8edf0;transition:background .2s ease,border-color .2s ease}.mega-link:hover,.mega-link.selected{background:#f4f8fb;border-color:#4091bf}.service-icon{width:34px;flex:0 0 34px;color:#4091bf}.service-icon svg{display:block;width:31px;height:31px;fill:none;stroke:currentColor;stroke-width:1.45;stroke-linecap:round;stroke-linejoin:round}.mega-link-copy{min-width:0;display:flex;flex:1;flex-direction:column;gap:6px}.mega-link-copy strong{font-size:12px;line-height:1.45;font-weight:750}.mega-link-copy small{color:#89929b;font-size:10px;line-height:1.4}.transformation-links .mega-link{min-height:116px;align-items:flex-start;flex-direction:column;gap:12px;padding:18px 16px}.transformation-links .mega-link-copy{gap:0}.transformation-links .mega-link-copy small{display:none}.transformation-links .link-chevron{align-self:flex-end;margin-top:auto}.link-chevron{width:15px;height:15px;flex:0 0 15px;fill:none;stroke:#9ba5ad;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s ease,color .2s ease}.mega-link:hover .link-chevron{color:#4091bf;transform:translateX(3px)}



  .nav-cta{display:inline-flex;align-items:center;justify-content:center;gap:13px;padding:14px 21px;background:#4091bf;color:#fff!important;border-radius:999px;font-size:12px;font-weight:750;text-decoration:none;white-space:nowrap;transition:background .2s ease,transform .2s ease}.nav-cta:hover{background:#287da9;transform:translateY(-1px)}.nav-cta svg{width:15px;height:15px}



  .mobile-menu-button,.mobile-nav{display:none}



  @media(max-width:1120px){.header-container{width:calc(100% - 40px)}.desktop-nav{gap:17px}.desktop-nav>a:not(.nav-cta),.nav-dropdown-trigger{font-size:12px}.nav-cta{padding:12px 16px}.mega-menu-inner{width:100%}.mega-links{grid-template-columns:repeat(2,minmax(0,1fr))}.transformation-links{grid-template-columns:repeat(2,minmax(0,1fr))}}



  @media(max-width:980px){.header-container{height:76px;width:calc(100% - 36px)}.logo-img{height:57px}.desktop-nav{display:none}.mobile-menu-button{width:44px;height:44px;display:flex;flex-direction:column;justify-content:center;gap:6px;padding:10px;border:0;background:transparent;cursor:pointer}.mobile-menu-button span{height:2px;width:100%;background:#303238;transition:transform .2s ease,opacity .2s ease}.mobile-menu-button.is-open span:first-child{transform:translateY(8px) rotate(45deg)}.mobile-menu-button.is-open span:nth-child(2){opacity:0}.mobile-menu-button.is-open span:last-child{transform:translateY(-8px) rotate(-45deg)}.mobile-nav{display:none;max-height:calc(100vh - 76px);overflow:auto;padding:8px 24px 28px;background:#fff;border-top:1px solid #e9edf0}.mobile-nav.is-open{display:block}.mobile-nav>a,.mobile-nav summary{display:flex;align-items:center;justify-content:space-between;padding:17px 0;color:#303238;font-size:14px;font-weight:650;text-decoration:none;cursor:pointer;border-bottom:1px solid #e9edf0}.mobile-nav>a.active,.mobile-nav summary:hover{color:#4091bf}.mobile-services-dropdown{border-bottom:1px solid #e9edf0}.mobile-services-dropdown summary{list-style:none}.mobile-services-dropdown summary::-webkit-details-marker{display:none}.mobile-services-dropdown[open] summary .chevron{transform:rotate(180deg)}.mobile-services{padding:2px 0 18px}.mobile-transformation-services{padding-top:0}.mobile-services>p{margin:3px 0 12px;color:#7c858d;font-size:12px;line-height:1.6}.mobile-services>a{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 4px;color:#303238;font-size:12px;line-height:1.45;text-decoration:none;border-top:1px solid #edf0f2}.mobile-services>a svg{width:15px;height:15px;flex:0 0 15px;fill:none;stroke:#4091bf;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.mobile-services .mobile-all-services{display:inline-flex;margin-top:12px;padding:11px 0;color:#277eae;font-weight:750;border:0}.mobile-nav .mobile-nav-cta{justify-content:center;margin-top:18px;padding:15px 20px;background:#4091bf;color:#fff;border:0;border-radius:999px}.mobile-nav .mobile-nav-cta:hover{background:#287da9;color:#fff}}



  @media(max-width:480px){.header-container{width:calc(100% - 28px)}.logo-img{height:52px}.mobile-nav{padding-right:16px;padding-left:16px}}



  @media(prefers-reduced-motion:reduce){.site-header \\\*,.site-header \\\*::before,.site-header \\\*::after{transition:none!important}}



</style>







<script>



  const menuButton = document.querySelector('.mobile-menu-button');



  const mobileNav = document.querySelector('.mobile-nav');



  const dropdowns = document.querySelectorAll('.nav-dropdown');







  menuButton?.addEventListener('click', () => {



    if (!menuButton || !mobileNav) return;



    const opening = menuButton.getAttribute('aria-expanded') !== 'true';



    menuButton.setAttribute('aria-expanded', String(opening));



    menuButton.setAttribute('aria-label', opening ? 'Close navigation menu' : 'Open navigation menu');



    menuButton.classList.toggle('is-open', opening);



    mobileNav.classList.toggle('is-open', opening);



    mobileNav.setAttribute('aria-hidden', String(!opening));



  });







  dropdowns.forEach((dropdown) => {



    const trigger = dropdown.querySelector('.nav-dropdown-trigger');



    trigger?.addEventListener('click', (event) => {



      event.stopPropagation();



      const opening = !dropdown.classList.contains('is-open');



      dropdowns.forEach((other) => {



        other.classList.remove('is-open');



        other.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');



      });



      if (opening) {



        dropdown.classList.add('is-open');



        trigger.setAttribute('aria-expanded', 'true');



      }



    });



  });







  document.addEventListener('click', (event) => {



    const target = event.target;



    dropdowns.forEach((dropdown) => {



      if (target instanceof Node && !dropdown.contains(target)) {



        dropdown.classList.remove('is-open');



        dropdown.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');



      }



    });



  });







  mobileNav?.querySelectorAll('a').forEach((link) => {



    link.addEventListener('click', () => {



      menuButton?.classList.remove('is-open');



      menuButton?.setAttribute('aria-expanded', 'false');



      menuButton?.setAttribute('aria-label', 'Open navigation menu');



      mobileNav.classList.remove('is-open');



      mobileNav.setAttribute('aria-hidden', 'true');



    });



  });







  document.addEventListener('keydown', (event) => {



    if (event.key !== 'Escape') return;



    dropdowns.forEach((dropdown) => {



      dropdown.classList.remove('is-open');



      dropdown.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');



    });



    menuButton?.classList.remove('is-open');



    menuButton?.setAttribute('aria-expanded', 'false');



    menuButton?.setAttribute('aria-label', 'Open navigation menu');



    mobileNav?.classList.remove('is-open');



    mobileNav?.setAttribute('aria-hidden', 'true');



  });







  window.addEventListener('resize', () => {



    if (window.innerWidth > 980) {



      menuButton?.classList.remove('is-open');



      menuButton?.setAttribute('aria-expanded', 'false');



      mobileNav?.classList.remove('is-open');



      mobileNav?.setAttribute('aria-hidden', 'true');



    }



  });



</script>
